<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.company.automation</groupId>
    <artifactId>automation-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Automation Parent</name>
    <description>
        Shared parent POM for the automation frameworks. Centralises Java/encoding settings,
        common dependency versions (dependencyManagement) and plugin wiring (pluginManagement)
        so the Appium and Playwright frameworks stay in sync and avoid version drift.
    </description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Shared (used by both frameworks) -->
        <allure.version>2.27.0</allure.version>
        <allure.maven.version>2.12.0</allure.maven.version>
        <log4j.version>2.23.1</log4j.version>
        <jackson.version>2.17.1</jackson.version>
        <surefire.version>3.2.5</surefire.version>
        <aspectj.version>1.9.22</aspectj.version>
        <spotless.version>2.43.0</spotless.version>
        <google.java.format.version>1.22.0</google.java.format.version>

        <!-- Appium-specific -->
        <appium.version>9.2.3</appium.version>
        <selenium.version>4.21.0</selenium.version>
        <testng.version>7.10.2</testng.version>
        <poi.version>5.2.5</poi.version>

        <!-- Playwright-specific -->
        <playwright.version>1.47.0</playwright.version>
        <junit.version>5.11.0</junit.version>
        <assertj.version>3.26.3</assertj.version>
        <exec.maven.version>3.3.0</exec.maven.version>

        <!-- Typed configuration binding (both frameworks): Spring Boot's Binder only, not the full starter -->
        <spring.boot.version>3.3.4</spring.boot.version>

        <!-- Code coverage (unit tests). jacocoArgLine is populated at runtime by JaCoCo's
             prepare-agent (propertyName=jacocoArgLine) and appended to Surefire's argLine.
             Not declared as a <properties> entry (that would shadow the runtime value). -->
        <jacoco.version>0.8.12</jacoco.version>

        <!-- JUnit 5 tags excluded from the default gate run (override with -DexcludedGroups=). -->
        <excludedGroups>quarantine</excludedGroups>
    </properties>

    <!-- Versions managed centrally; children declare the deps without a <version>. -->
    <dependencyManagement>
        <dependencies>
            <!-- Shared -->
            <dependency>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-testng</artifactId>
                <version>${allure.version}</version>
            </dependency>
            <dependency>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-junit5</artifactId>
                <version>${allure.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-core</artifactId>
                <version>${log4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-api</artifactId>
                <version>${log4j.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.dataformat</groupId>
                <artifactId>jackson-dataformat-csv</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.aspectj</groupId>
                <artifactId>aspectjweaver</artifactId>
                <version>${aspectj.version}</version>
            </dependency>

            <!-- Appium-specific -->
            <dependency>
                <groupId>io.appium</groupId>
                <artifactId>java-client</artifactId>
                <version>${appium.version}</version>
            </dependency>
            <dependency>
                <groupId>org.seleniumhq.selenium</groupId>
                <artifactId>selenium-java</artifactId>
                <version>${selenium.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testng</groupId>
                <artifactId>testng</artifactId>
                <version>${testng.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml</artifactId>
                <version>${poi.version}</version>
            </dependency>
            <!-- Spring Boot Binder for typed/validated config (transitively pulls spring-core/context). -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot</artifactId>
                <version>${spring.boot.version}</version>
            </dependency>

            <!-- Playwright-specific -->
            <dependency>
                <groupId>com.microsoft.playwright</groupId>
                <artifactId>playwright</artifactId>
                <version>${playwright.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Plugin versions + default config managed centrally; children enable + add specifics. -->
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.version}</version>
                    <configuration>
                        <argLine>
                            -javaagent:"${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar"
                            ${jacocoArgLine}
                        </argLine>
                        <systemPropertyVariables>
                            <!-- Where Allure writes raw result files -->
                            <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
                        </systemPropertyVariables>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>org.aspectj</groupId>
                            <artifactId>aspectjweaver</artifactId>
                            <version>${aspectj.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>

                <plugin>
                    <groupId>io.qameta.allure</groupId>
                    <artifactId>allure-maven</artifactId>
                    <version>${allure.maven.version}</version>
                    <configuration>
                        <reportVersion>${allure.version}</reportVersion>
                        <resultsDirectory>${project.build.directory}/allure-results</resultsDirectory>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec.maven.version}</version>
                </plugin>

                <!-- Code coverage. prepare-agent writes the agent VM arg into ${jacocoArgLine},
                     which the Surefire argLine above appends; report renders target/site/jacoco.
                     Enabled per module (children declare the plugin to activate it). -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <configuration>
                        <!-- Framework code lives under src/test; the module points
                             build/outputDirectory at test-classes so report finds them. -->
                        <sourceDirectory>${project.basedir}/src/test/java</sourceDirectory>
                        <!-- Coverage targets the testable logic; device/browser-bound and
                             reference classes are excluded as they need a real environment. -->
                        <excludes>
                            <exclude>**/pages/**</exclude>
                            <exclude>**/tests/**</exclude>
                            <exclude>**/listeners/**</exclude>
                            <exclude>**/base/**</exclude>
                            <exclude>**/driver/DriverFactory.*</exclude>
                            <exclude>**/driver/DriverManager.*</exclude>
                            <exclude>**/driver/AppiumServerManager.*</exclude>
                            <exclude>**/driver/PlaywrightFactory.*</exclude>
                            <exclude>**/driver/PlaywrightManager.*</exclude>
                            <exclude>**/driver/api/**</exclude>
                            <exclude>**/unit/**</exclude>
                        </excludes>
                    </configuration>
                    <executions>
                        <execution>
                            <id>jacoco-prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                            <configuration>
                                <propertyName>jacocoArgLine</propertyName>
                            </configuration>
                        </execution>
                        <execution>
                            <id>jacoco-report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                            <configuration>
                                <dataFile>${project.build.directory}/jacoco.exec</dataFile>
                                <sourceDirectory>${project.basedir}/src/test/java</sourceDirectory>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <!-- Code style: `mvn spotless:check` (CI) / `mvn spotless:apply` (fix). -->
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless.version}</version>
                    <configuration>
                        <java>
                            <googleJavaFormat>
                                <version>${google.java.format.version}</version>
                                <style>AOSP</style>
                            </googleJavaFormat>
                            <removeUnusedImports/>
                            <importOrder/>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                        </java>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
