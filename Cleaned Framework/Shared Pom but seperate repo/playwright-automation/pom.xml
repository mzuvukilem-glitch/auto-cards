<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.company.automation</groupId>
        <artifactId>automation-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../automation-parent/pom.xml</relativePath>
    </parent>

    <artifactId>playwright-automation</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Playwright Web Automation</name>
    <description>Playwright for Java + JUnit 5 + Maven web UI automation framework (Page Object Model)</description>

    <!--
      Versions, plugin versions and shared plugin config are inherited from
      automation-parent (dependencyManagement / pluginManagement). This POM only
      declares which dependencies/plugins this framework uses plus Playwright-specific
      config (Surefire excludedGroups, the browser-install exec plugin).
    -->
    <dependencies>
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-junit5</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- CSV test-data support (same Jackson version as databind). -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-csv</artifactId>
        </dependency>

        <!-- AssertJ: fluent + soft assertions (JUnit 5 has no built-in SoftAssert). -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Inherits version/argLine/allure-results config from the parent;
                 adds the Playwright-specific quarantine exclusion. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Known-flaky tests tagged "quarantine" are excluded from the gate run.
                         Run them deliberately with: mvn test -Dgroups=quarantine -DexcludedGroups= -->
                    <excludedGroups>${excludedGroups}</excludedGroups>
                </configuration>
            </plugin>

            <!-- Lets you run: mvn exec:java -Dexec.mainClass=... to install browsers -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>

            <!-- Enabled here; fully configured by the parent's pluginManagement. -->
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
