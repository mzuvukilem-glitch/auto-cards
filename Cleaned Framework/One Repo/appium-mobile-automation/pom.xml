<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.company.automation</groupId>
        <artifactId>automation-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../automation-parent/pom.xml</relativePath>
    </parent>

    <artifactId>appium-mobile-automation</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Appium Mobile Automation</name>
    <description>Appium + TestNG + Maven mobile automation framework (Page Object Model)</description>

    <properties>
        <!-- Default TestNG suite = device gate. Override with -DsuiteXmlFile=unit-tests.xml. -->
        <suiteXmlFile>testng.xml</suiteXmlFile>
    </properties>

    <!--
      Versions, plugin versions and shared plugin config are inherited from
      automation-parent (dependencyManagement / pluginManagement). This POM only
      declares which dependencies/plugins this framework uses plus Appium-specific
      config (the TestNG suite file).
    -->
    <dependencies>
        <dependency>
            <groupId>com.company.automation</groupId>
            <artifactId>automation-commons</artifactId>
        </dependency>

        <dependency>
            <groupId>io.appium</groupId>
            <artifactId>java-client</artifactId>
        </dependency>

        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
        </dependency>

        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
        </dependency>

        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-testng</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- CSV test-data support (same Jackson version as databind). -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-csv</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>

        <!-- Spring Boot Binder: typed + validated configuration behind ConfigReader. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>
    </dependencies>

    <build>
        <!-- Framework code lives under src/test (no src/main), so compiled classes land in
             test-classes. Point the project output dir there so JaCoCo's report (which reads
             the build output directory) analyses the real classes. -->
        <outputDirectory>${project.build.directory}/test-classes</outputDirectory>
        <plugins>
            <!-- Inherits version/argLine/allure-results config from the parent;
                 adds the Appium-specific TestNG suite file. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Default = device gate suite. Run device-free unit tests with
                         -DsuiteXmlFile=unit-tests.xml (used for coverage). -->
                    <suiteXmlFiles>
                        <suiteXmlFile>${suiteXmlFile}</suiteXmlFile>
                    </suiteXmlFiles>
                </configuration>
            </plugin>

            <!-- Enabled here; fully configured by the parent's pluginManagement. -->
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
            <!-- Code coverage for the unit suite (configured in automation-parent). -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
