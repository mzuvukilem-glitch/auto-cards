# Copy to .env (git-ignored) and fill in. Never commit real secrets.
# Resolution order: -Dkey=... > env var (KEY or UPPER_SNAKE) > .env

# Device-cloud credentials (used when -Ddevice.farm=browserstack|saucelabs)
cloud.user=
cloud.key=

# Optional cloud run metadata
cloud.project=ATom Mobile
cloud.build=local-build
