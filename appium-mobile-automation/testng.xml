<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="AppiumMobileSuite" parallel="tests" thread-count="4" verbose="1">

    <listeners>
        <listener class-name="com.company.automation.listeners.TestListener"/>
    </listeners>

    <!-- ================= Android ================= -->
    <test name="Smoke Tests - Android">
        <parameter name="platform" value="android"/>
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.company.automation.tests.LoginTests"/>
            <class name="com.company.automation.tests.SmokeTests"/>
        </classes>
    </test>

    <test name="Regression Tests - Android">
        <parameter name="platform" value="android"/>
        <classes>
            <class name="com.company.automation.tests.LoginTests"/>
            <class name="com.company.automation.tests.CheckoutTests"/>
        </classes>
    </test>

    <!-- ================= iOS ================= -->
    <test name="Smoke Tests - iOS">
        <parameter name="platform" value="ios"/>
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.company.automation.tests.LoginTests"/>
            <class name="com.company.automation.tests.SmokeTests"/>
        </classes>
    </test>

    <test name="Regression Tests - iOS">
        <parameter name="platform" value="ios"/>
        <classes>
            <class name="com.company.automation.tests.LoginTests"/>
            <class name="com.company.automation.tests.CheckoutTests"/>
        </classes>
    </test>

</suite>
