# Copy to .env and set real values. Never commit .env.
PORT=4000
# Password for signing in to the planner (required, min 12 chars)
APP_PASSWORD=
# Random string used to sign session cookies (required, min 32 chars)
SESSION_SECRET=
# SQLite file location
DB_PATH=./data/planner.db
# Set to true when served over HTTPS so the session cookie is Secure
COOKIE_SECURE=false
